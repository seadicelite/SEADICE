rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedback/{doc} {
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 200
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 100;
      allow read, update, delete: if false;
    }

    match /book_quiz_decks/{doc} {
      // 誰でも読めるので、決まった項目・長さ以外は受け付けない（カード1枚ずつの長さはルールでは数えられない）
      allow create: if request.resource.data.keys().hasOnly(
                        ['bookTitle', 'bookTitleLower', 'author', 'cards', 'deviceId', 'createdAt'])
                    && request.resource.data.bookTitle is string
                    && request.resource.data.bookTitle.size() > 0
                    && request.resource.data.bookTitle.size() <= 200
                    && request.resource.data.bookTitleLower is string
                    && request.resource.data.bookTitleLower.size() <= 200
                    && request.resource.data.author is string
                    && request.resource.data.author.size() <= 100
                    && request.resource.data.cards is list
                    && request.resource.data.cards.size() > 0
                    && request.resource.data.cards.size() <= 50
                    && request.resource.data.deviceId is string
                    && request.resource.data.deviceId.size() <= 100
                    && (!('createdAt' in request.resource.data)
                        || (request.resource.data.createdAt is string
                            && request.resource.data.createdAt.size() <= 40));
      allow read: if true;
      allow update, delete: if false;
    }
  }

}
