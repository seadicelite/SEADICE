      },
      {
        "source": "/tools/pet-health/**",
        "destination": "/tools/pet-health/index.html"
      },
      {
        "source": "/apps/pet-health-app1/**",
        "destination": "/apps/pet-health-app1/index.html"
      },
      {
        "source": "/apps/pet-health-app2/**",
        "destination": "/apps/pet-health-app2/index.html"
      },
