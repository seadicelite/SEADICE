      },
      {
        "source": "/jinsei_pyramid/**",
        "destination": "/jinsei_pyramid/index.html"
      },
      {
        "source": "/apps/drone-cbt/**",
        "destination": "/apps/drone-cbt/index.html"
      },
      {
        "source": "/apps/lifeisrpg/**",
        "destination": "/apps/lifeisrpg/index.html"
      },
      {
        "source": "/apps/toite/**",
        "destination": "/apps/toite/index.html"
      },
      {
        "source": "/apps/rakuraku/**",
        "destination": "/apps/rakuraku/index.html"
      },
