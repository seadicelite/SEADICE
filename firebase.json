      },
      {
        "source": "/privacy/jikka-seiri-app1/**",
        "destination": "/privacy/jikka-seiri-app1/index.html"
      },
      {
        "source": "/privacy/jikka-seiri-app2/**",
        "destination": "/privacy/jikka-seiri-app2/index.html"
      },
      {
        "source": "/privacy/jikka-seiri-app3/**",
        "destination": "/privacy/jikka-seiri-app3/index.html"
      },
      {
        "source": "/privacy/kateisaien-app1/**",
        "destination": "/privacy/kateisaien-app1/index.html"
      },
      {
        "source": "/privacy/kateisaien-app2/**",
