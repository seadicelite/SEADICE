{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log"
    ]
  },
  "hosting": {
    "public": "p",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/lifeisrpg/**",
        "destination": "/lifeisrpg/index.html"
      },
      {
        "source": "/kao_type_diag/**",
        "destination": "/kao_type_diag/index.html"
      },
      {
        "source": "/toite/**",
        "destination": "/toite/index.html"
      },
      {
        "source": "/focus-dice/**",
        "destination": "/focus-dice/index.html"
      },
      {
        "source": "/rakuraku/**",
        "destination": "/rakuraku/index.html"
      },
      {
        "source": "/boueki-hub/kentei/**",
        "destination": "/boueki-hub/kentei/index.html"
      },
      {
        "source": "/boueki-hub/jitsumu-word/**",
        "destination": "/boueki-hub/jitsumu-word/index.html"
      },
      {
        "source": "/boueki-hub/srs/**",
        "destination": "/boueki-hub/srs/index.html"
      },
      {
        "source": "/boueki-hub/english-word/**",
        "destination": "/boueki-hub/english-word/index.html"
      },
      {
        "source": "/boueki-hub/**",
        "destination": "/boueki-hub/index.html"
      },
      {
        "source": "/boueki/**",
        "destination": "/boueki/index.html"
      },
      {
        "source": "/drone/anki/**",
        "destination": "/drone/anki/index.html"
      },
      {
        "source": "/jinsei_pyramid/**",
        "destination": "/jinsei_pyramid/index.html"
      },
      {
        "source": "/apps/line-honne-scan/**",
        "destination": "/apps/line-honne-scan/index.html"
      },
      {
        "source": "/privacy/line-honne-scan/**",
        "destination": "/privacy/line-honne-scan/index.html"
      },
      {
        "source": "/tools/omikuji-zodiac/**",
        "destination": "/tools/omikuji-zodiac/index.html"
      },
      {
        "source": "/apps/omikuji-zodiac/**",
        "destination": "/apps/omikuji-zodiac/index.html"
      },
      {
        "source": "/privacy/omikuji-zodiac/**",
        "destination": "/privacy/omikuji-zodiac/index.html"
      },
      {
        "source": "/tools/yokai-mirror/**",
        "destination": "/tools/yokai-mirror/index.html"
      },
      {
        "source": "/apps/yokai-mirror/**",
        "destination": "/apps/yokai-mirror/index.html"
      },
      {
        "source": "/privacy/yokai-mirror/**",
        "destination": "/privacy/yokai-mirror/index.html"
      },
      {
        "source": "/tools/yumetoki/**",
        "destination": "/tools/yumetoki/index.html"
      },
      {
        "source": "/apps/yumetoki/**",
        "destination": "/apps/yumetoki/index.html"
      },
      {
        "source": "/privacy/yumetoki/**",
        "destination": "/privacy/yumetoki/index.html"
      },
      {
        "source": "/tools/mbti-compass/**",
        "destination": "/tools/mbti-compass/index.html"
      },
      {
        "source": "/apps/mbti-compass/**",
        "destination": "/apps/mbti-compass/index.html"
      },
      {
        "source": "/privacy/mbti-compass/**",
        "destination": "/privacy/mbti-compass/index.html"
      },
      {
        "source": "/tools/hsp-relationship-check/**",
        "destination": "/tools/hsp-relationship-check/index.html"
      },
      {
        "source": "/apps/hsp-relationship-check/**",
        "destination": "/apps/hsp-relationship-check/index.html"
      },
      {
        "source": "/privacy/hsp-relationship-check/**",
        "destination": "/privacy/hsp-relationship-check/index.html"
      },
      {
        "source": "/tools/cognitive-bias-guide/**",
        "destination": "/tools/cognitive-bias-guide/index.html"
      },
      {
        "source": "/apps/cognitive-bias-guide/**",
        "destination": "/apps/cognitive-bias-guide/index.html"
      },
      {
        "source": "/privacy/cognitive-bias-guide/**",
        "destination": "/privacy/cognitive-bias-guide/index.html"
      },
      {
        "source": "/tools/kanyou-shindan/**",
        "destination": "/tools/kanyou-shindan/index.html"
      },
      {
        "source": "/apps/kanyou-shindan/**",
        "destination": "/apps/kanyou-shindan/index.html"
      },
      {
        "source": "/privacy/kanyou-shindan/**",
        "destination": "/privacy/kanyou-shindan/index.html"
      },
      {
        "source": "/tools/fbi-bodylanguage/**",
        "destination": "/tools/fbi-bodylanguage/index.html"
      },
      {
        "source": "/apps/fbi-bodylanguage/**",
        "destination": "/apps/fbi-bodylanguage/index.html"
      },
      {
        "source": "/privacy/fbi-bodylanguage/**",
        "destination": "/privacy/fbi-bodylanguage/index.html"
      },
      {
        "source": "/tools/procrastination-type/**",
        "destination": "/tools/procrastination-type/index.html"
      },
      {
        "source": "/apps/procrastination-type/**",
        "destination": "/apps/procrastination-type/index.html"
      },
      {
        "source": "/privacy/procrastination-type/**",
        "destination": "/privacy/procrastination-type/index.html"
      },
      {
        "source": "/tools/omamori-guide/**",
        "destination": "/tools/omamori-guide/index.html"
      },
      {
        "source": "/apps/omamori-guide/**",
        "destination": "/apps/omamori-guide/index.html"
      },
      {
        "source": "/privacy/omamori-guide/**",
        "destination": "/privacy/omamori-guide/index.html"
      },
      {"source": "/tools/japanglish/**", "destination": "/tools/japanglish/index.html"},
      {"source": "/apps/japanglish/**", "destination": "/apps/japanglish/index.html"},
      {"source": "/privacy/japanglish/**", "destination": "/privacy/japanglish/index.html"},
      {"source": "/tools/wagashi-muse/**", "destination": "/tools/wagashi-muse/index.html"},
      {"source": "/apps/wagashi-muse/**", "destination": "/apps/wagashi-muse/index.html"},
      {"source": "/privacy/wagashi-muse/**", "destination": "/privacy/wagashi-muse/index.html"},
      {"source": "/tools/chado-sensei/**", "destination": "/tools/chado-sensei/index.html"},
      {"source": "/apps/chado-sensei/**", "destination": "/apps/chado-sensei/index.html"},
      {"source": "/privacy/chado-sensei/**", "destination": "/privacy/chado-sensei/index.html"},
      {"source": "/tools/matsuri-compass/**", "destination": "/tools/matsuri-compass/index.html"},
      {"source": "/apps/matsuri-compass/**", "destination": "/apps/matsuri-compass/index.html"},
      {"source": "/privacy/matsuri-compass/**", "destination": "/privacy/matsuri-compass/index.html"},
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/apps/boueki/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/apps/boueki/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/apps/boueki/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/apps/boueki/flutter.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/apps/boueki/main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/apps/boueki/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/flutter.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          },
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ]
  }
}
